# HTTP server bind address
HTTP_ADDR=:8080

# PostgreSQL connection string for GORM / pgx
# Example: postgres://user:pass@localhost:5432/dbname?sslmode=disable
POSTGRES_DSN=postgres://user:password@localhost:5432/marketplace_bridge?sslmode=disable

# Client must send this header name and value on POST /instantiate
SECURITY_HEADER_NAME=GCP_POGR_MARKETPLACE_BRIDGE
SECURITY_HEADER_VALUE=834c7b25-43e2-4494-ad8b-50f2f159c6cf

# How often to scan for webhook deliveries (default 30s)
WEBHOOK_POLL_INTERVAL=30s

# Delay before the webhook callback may run (default 5h). Use short values only in dev/tests.
# WEBHOOK_NOTIFY_DELAY=5h
